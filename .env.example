# ─── Database ────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Admin panel auth ────────────────────────────────────────
# Used only to seed the first admin user (prisma/seed.ts).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

# Secret used to sign the admin session cookie (any long random string).
AUTH_SECRET="replace-with-a-long-random-secret-string"

# ─── Telegram bot ────────────────────────────────────────────
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=""

# Chat ID of the group that should receive ZERO RISK applications.
# Add the bot to the group, then get the id (see README).
TELEGRAM_ZERO_RISK_CHAT_ID=""

# Chat ID of the group that should receive CAREER / CV submissions.
TELEGRAM_CAREERS_CHAT_ID=""

# Public base URL (used in Telegram messages to link back to admin).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
