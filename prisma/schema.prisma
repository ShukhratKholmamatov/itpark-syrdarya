generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String // bcrypt hash
  name      String   @default("Administrator")
  createdAt DateTime @default(now())
}

/// A news / blog post written from the admin panel.
/// Title and body are stored for all three locales so the public
/// news page can render in UZ / RU / EN.
model NewsPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  coverImage  String? // /uploads/news/....webp

  titleUz     String
  titleRu     String
  titleEn     String

  excerptUz   String   @default("")
  excerptRu   String   @default("")
  excerptEn   String   @default("")

  bodyUz      String
  bodyRu      String
  bodyEn      String

  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

/// Zero Risk program applications. Forwarded to the Zero Risk Telegram group.
model ZeroRiskApplication {
  id          Int      @id @default(autoincrement())
  fullName    String
  contact     String // phone or email
  companyName String
  message     String   @default("")
  locale      String   @default("uz")
  delivered   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// CV / career submissions from Sirdaryo youth. Forwarded to the Careers Telegram group.
model CareerApplication {
  id         Int      @id @default(autoincrement())
  fullName   String
  contact    String
  field      String   @default("")
  message    String   @default("")
  cvFile     String? // /uploads/cv/....
  locale     String   @default("uz")
  delivered  Boolean  @default(false)
  createdAt  DateTime @default(now())
}
